{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{Qt6_ROOT}",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_CXX_FLAGS": "/utf-8 /W4 /permissive-",
        "BUILD_TESTING": "ON"
      },
      "environment": {
        "Qt6_ROOT": "C:/Qt/6.10.3/msvc2022_64",
        "VSLANG": "1033",
        "PATH": "$env{Qt6_ROOT}/bin;$penv{PATH}"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "environment": {
        "PATH": "$env{Qt6_ROOT}/bin;${sourceDir}/vcpkg_installed/x64-windows/debug/bin;$penv{PATH}"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "environment": {
        "PATH": "$env{Qt6_ROOT}/bin;${sourceDir}/vcpkg_installed/x64-windows/bin;$penv{PATH}"
      }
    },
    {
      "name": "windows-release-cuda",
      "inherits": "windows-release",
      "cacheVariables": {
        "SUBCUE_ENABLE_CUDA": "ON"
      },
      "environment": {
        "PATH": "$env{CUDA_PATH}/bin/x64;$env{CUDA_PATH}/bin;$env{Qt6_ROOT}/bin;${sourceDir}/vcpkg_installed/x64-windows/bin;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-release-cuda",
      "configurePreset": "windows-release-cuda"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release-cuda",
      "configurePreset": "windows-release-cuda",
      "output": { "outputOnFailure": true }
    }
  ]
}
