prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/../include

Name: libavformat
Description: FFmpeg container format library
Version: 63.1.101
Requires: 
Requires.private: libavcodec >= 63.1.101, libswresample >= 7.1.101, libavutil >= 61.1.101
Conflicts:
Libs: "-L${libdir}" -lavformat
Libs.private: -lsecur32 -lncrypt -lcrypt32 -lws2_32
Cflags: "-I${includedir}"

