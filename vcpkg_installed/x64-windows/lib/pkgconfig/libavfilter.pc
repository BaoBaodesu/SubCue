prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 12.1.101
Requires: 
Requires.private: libswscale >= 10.1.101, libavformat >= 63.1.101, libavcodec >= 63.1.101, libswresample >= 7.1.101, libavutil >= 61.1.101
Conflicts:
Libs: "-L${libdir}" -lavfilter
Libs.private: 
Cflags: "-I${includedir}"

