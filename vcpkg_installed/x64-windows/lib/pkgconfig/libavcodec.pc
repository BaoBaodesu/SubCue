prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavcodec
Description: FFmpeg codec library
Version: 63.1.101
Requires: 
Requires.private: libswresample >= 7.1.101, libavutil >= 61.1.101
Conflicts:
Libs: "-L${libdir}" -lavcodec
Libs.private: -lmfuuid -lole32 -lstrmiids -lole32 -luser32
Cflags: "-I${includedir}"

