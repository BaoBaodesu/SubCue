# 构建产物与便携包
out/
dist/
build/

# 编译中间文件与可执行文件
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.idb

# 本地 IDE 与工具缓存
.idea/
.vscode/
.vs/
compile_commands.json

# golden 再生脚本的 Python 缓存
__pycache__/
*.py[cod]
.venv-inference/
.venv-ml/
.uv-cache/

# 测试运行期临时目录
.test_appdata/
.test_tmp/

# 用户丢在 tests/ 根目录的本地素材；正式夹具只在 media/ 与 golden/
/tests/*.wav
/tests/*.mp4
/tests/*.pkf
/tests/*.docx

# 本地模型与运行期数据（模型只保存在工作区，不参与清理或提交）
models/
.ledger/
logs/
/settings.json
/credentials.dat
/*.log
/*.err
/$log
